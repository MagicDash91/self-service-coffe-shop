# Copy to .env and edit. Every setting is optional; the defaults are shown. Never commit .env.

# LLM (Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi4-mini

# Speech-to-text
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=id
# WHISPER_BEAM=5
# STT_FIX=1

# Text-to-speech: piper (local) | edge (free online) | none
# TTS_ENGINE=piper
# PIPER_VOICE=id_ID-news_tts-medium

# ESP32 voice units
# DEVICE_TOKEN=
# DEVICE_IDLE_RESET_S=180

# LangSmith tracing (transcripts are uploaded, audio never is)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=kopi-kiosk
